# Copiar este arquivo para ".env.local" e preencher com valores reais.
# Nunca commitar o ".env.local".

# Chave da YouTube Data API v3 — usada apenas no servidor (src/lib/youtube.ts).
# Enquanto não for configurada, o site usa os dados de exemplo em src/data/videos.ts.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
